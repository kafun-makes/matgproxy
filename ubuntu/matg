#!/bin/bash

# Пути и конфигурация
CONFIG_FILE="/etc/tg_proxy_config.txt"
SERVICE_FILE="/etc/systemd/system/tg-proxy.service"
BINARY_PATH="/usr/local/bin/mtg"
CLI_PATH="/usr/local/bin/matg"

# Дефолтные настройки
PORT=2834
SECRET=""
LANG_CHOICE="ru"

# Проверка на root
if [ "$EUID" -ne 0 ]; then
  echo "Пожалуйста, запустите скрипт от имени root (через sudo)."
  exit 1
fi

# Функции работы с конфигом
load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        PORT=$(sed -n '1p' "$CONFIG_FILE")
        SECRET=$(sed -n '2p' "$CONFIG_FILE")
        LANG_CHOICE=$(sed -n '3p' "$CONFIG_FILE")
    fi
}

save_config() {
    echo "$PORT" > "$CONFIG_FILE"
    echo "$SECRET" >> "$CONFIG_FILE"
    echo "$LANG_CHOICE" >> "$CONFIG_FILE"
}

generate_secret() {
    # Генерируем секрет с префиксом "ee" для обхода DPI блокировок (Fake TLS)
    echo "ee$(openssl rand -hex 16)"
}

get_public_ip() {
    local ip
    ip=$(curl -s https://ifconfig.me/ip || wget -qO- https://ifconfig.me/ip)
    echo "${ip:-YOUR_SERVER_IP}"
}

# Функция динамического перевода строк (на замену сломанным массивам)
get_str() {
    local key=$1
    if [ "$LANG_CHOICE" = "ru" ]; then
        case $key in
            title) echo "         УПРАВЛЕНИЕ ТЕЛЕГРАМ MTPROTO [matg]        " ;;
            status) echo -n " Текущий статус службы: " ;;
            inactive) echo "ОСТАНОВЛЕН" ;;
            opt1) echo " 1. Показать ссылку для подключения в Telegram" ;;
            opt2) echo " 2. Изменить ПОРТ прокси" ;;
            opt3) echo " 3. Изменить СЕКРЕТ вручную" ;;
            opt4) echo " 4. Сгенерировать новый случайный секрет" ;;
            opt5) echo " 5. Запустить / Перезапустить прокси" ;;
            opt6) echo " 6. Остановить прокси" ;;
            opt7) echo " 7. Тест пинга до серверов Telegram" ;;
            opt8) echo " 8. ПОЛНОЕ УДАЛЕНИЕ (Деинсталляция)" ;;
            opt0) echo " 0. Выйти из меню" ;;
            choice) echo -n "Выберите действие (0-8): " ;;
            link_title) echo -e "\n Ссылка для Telegram:" ;;
            press_enter) echo -e "\nНажмите Enter для возврата в меню..." ;;
            port_changed) echo " Порт изменен. Не забудьте перезапустить прокси (пункт 5)." ;;
            secret_changed) echo " Секрет изменен. Не забудьте перезапустить прокси." ;;
            new_secret_gen) echo " Сгенерирован новый безопасный секрет с префиксом 'ee'." ;;
            restarting) echo -e "\n Перезапуск службы..." ;;
            restarted) echo " Прокси успешно перезапущен!" ;;
            stopping) echo -e "\n Остановка службы..." ;;
            stopped) echo " Прокси остановлен." ;;
            testing) echo -e "\nТестирование пинга до Telegram..." ;;
            test_fail) echo " Ошибка теста: Серверы Telegram недоступны." ;;
            uninstalling) echo -e "\nНачинаем полное удаление прокси из системы..." ;;
            uninstalled) echo "Прокси полностью удален. Команда matg больше недоступна." ;;
            init_done) echo -e "\n Настройка завершена! Команда 'matg' зарегистрирована." ;;
        esac
    else
        case $key in
            title) echo "         TELEGRAM MTPROTO MANAGEMENT [matg]        " ;;
            status) echo -n " Current service status: " ;;
            inactive) echo "STOPPED" ;;
            opt1) echo " 1. Show Telegram connection link" ;;
            opt2) echo " 2. Change proxy PORT" ;;
            opt3) echo " 3. Change SECRET manually" ;;
            opt4) echo " 4. Generate new random secret" ;;
            opt5) echo " 5. Start / Restart proxy" ;;
            opt6) echo " 6. Stop proxy" ;;
            opt7) echo " 7. Ping test to Telegram" ;;
            opt8) echo " 8. FULL UNINSTALL (Remove completely)" ;;
            opt0) echo " 0. Exit menu" ;;
            choice) echo -n "Select action (0-8): " ;;
            link_title) echo -e "\n Telegram Link:" ;;
            press_enter) echo -e "\nPress Enter to return to menu..." ;;
            port_changed) echo " Port changed. Don't forget to restart proxy (option 5)." ;;
            secret_changed) echo " Secret changed. Don't forget to restart proxy." ;;
            new_secret_gen) echo " New secure secret with 'ee' prefix generated." ;;
            restarting) echo -e "\n Restarting service..." ;;
            restarted) echo " Proxy successfully restarted!" ;;
            stopping) echo -e "\n Stopping service..." ;;
            stopped) echo " Proxy stopped." ;;
            testing) echo -e "\nTesting ping to Telegram cores..." ;;
            test_fail) echo " Test failed: Telegram cores are unreachable." ;;
            uninstalling) echo -e "\nStarting full uninstallation from the system..." ;;
            uninstalled) echo "Proxy completely removed. The 'matg' command is now disabled." ;;
            init_done) echo -e "\n Setup complete! Command 'matg' is registered." ;;
        esac
    fi
}

ensure_mtg_binary() {
    if [ ! -f "$BINARY_PATH" ]; then
        echo "Скачивание и установка бинарного файла mtg (MTProto)..."
        local ARCH
        ARCH=$(uname -m)
        if [ "$ARCH" = "x86_64" ]; then
            curl -sSL "https://github.com/9seconds/mtg/releases/download/v2.1.7/mtg-2.1.7-linux-amd64.tar.gz" | tar -xzO mtg-2.1.7-linux-amd64/mtg > "$BINARY_PATH"
        elif [[ "$ARCH" == "aarch64" || "$ARCH" == "arm64" ]]; then
            curl -sSL "https://github.com/9seconds/mtg/releases/download/v2.1.7/mtg-2.1.7-linux-arm64.tar.gz" | tar -xzO mtg-2.1.7-linux-arm64/mtg > "$BINARY_PATH"
        fi
        chmod +x "$BINARY_PATH"
    fi
}

setup_systemd() {
    ensure_mtg_binary
    cat <<EOF > "$SERVICE_FILE"
[Unit]
Description=Telegram MTProto Proxy (mtg)
After=network.target

[Service]
Type=simple
User=root
ExecStart=$BINARY_PATH run tcp://0.0.0.0:$PORT $SECRET
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable tg-proxy.service >/dev/null 2>&1
}

test_telegram() {
    get_str "testing"
    if ping -c 3 149.154.167.50 > /dev/null 2>&1; then
        echo -e "\n========================================"
        echo " Telegram DC IP: 149.154.167.50"
        echo " Доступность: ОТЛИЧНАЯ"
        echo "========================================"
    else
        get_str "test_fail"
    fi
}

full_uninstall() {
    get_str "uninstalling"
    systemctl stop tg-proxy.service >/dev/null 2>&1
    systemctl disable tg-proxy.service >/dev/null 2>&1
    rm -f "$SERVICE_FILE"
    systemctl daemon-reload
    rm -f "$BINARY_PATH"
    rm -f "$CONFIG_FILE"
    get_str "uninstalled"
    rm -f "$CLI_PATH"
    exit 0
}

# Инициализация при первом запуске через curl
load_config
if [ -z "$SECRET" ]; then
    clear
    echo "Choose language. (Выберите язык прокси-панели)"
    echo "1. English"
    echo "2. Русский"
    read -rp "Select (1-2): " l_num
    if [ "$l_num" = "1" ]; then LANG_CHOICE="en"; else LANG_CHOICE="ru"; fi

    SECRET=$(generate_secret)
    save_config
    setup_systemd
    systemctl start tg-proxy.service
    
    # Скачиваем сам себя в систему для работы локальной команды 'matg'
    curl -sSfL "https://raw.githubusercontent.com/kafun-makes/matgproxy/main/ubuntu/matg" -o "$CLI_PATH"
    chmod +x "$CLI_PATH"
    
    clear
    get_str "init_done"
    get_str "link_title"
    echo -e "\e[34mtg://proxy?server=$(get_public_ip)&port=$PORT&secret=$SECRET\e[0m"
    echo -e "\e[34mhttps://t.me/proxy?server=$(get_public_ip)&port=$PORT&secret=$SECRET\e[0m"
    exit 0
fi

# Главное меню управления
while true; do
    clear
    STATUS=$(systemctl is-active tg-proxy 2>/dev/null)
    
    echo "=================================================="
    get_str "title"
    echo "=================================================="
    get_str "status"
    
    if [ "$STATUS" = "active" ]; then
        if [ "$LANG_CHOICE" = "ru" ]; then
            echo -e "\e[92mРАБОТАЕТ (ПОРТ: $PORT)\e[0m"
        else
            echo -e "\e[92mRUNNING (PORT: $PORT)\e[0m"
        fi
    else
        if [ "$LANG_CHOICE" = "ru" ]; then
            echo -e "\e[91mОСТАНОВЛЕН\e[0m"
        else
            echo -e "\e[91mSTOPPED\e[0m"
        fi
    fi
    
    if [ "$LANG_CHOICE" = "ru" ]; then
        echo " Текущий Секрет (ee...): $SECRET"
    else
        echo " Current Secret (ee...): $SECRET"
    fi
    
    echo "--------------------------------------------------"
    get_str "opt1"
    get_str "opt2"
    get_str "opt3"
    get_str "opt4"
    get_str "opt5"
    get_str "opt6"
    get_str "opt7"
    echo -e "\e[91m$(get_str 'opt8')\e[0m"
    get_str "opt0"
    echo "=================================================="
    
    read -rp "$(get_str 'choice')" choice
    
    case $choice in
        1)
            get_str "link_title"
            echo -e "\e[34mtg://proxy?server=$(get_public_ip)&port=$PORT&secret=$SECRET\e[0m"
            echo -e "\e[34mhttps://t.me/proxy?server=$(get_public_ip)&port=$PORT&secret=$SECRET\e[0m"
            read -rp "$(get_str 'press_enter')"
            ;;
        2)
            if [ "$LANG_CHOICE" = "ru" ]; then
                read -rp $'\n'"Введите новый порт (сейчас $PORT): " new_port
            else
                read -rp $'\n'"Enter new port (current $PORT): " new_port
            fi
            if [[ "$new_port" =~ ^[0-9]+$ ]]; then
                PORT=$new_port
                save_config
                get_str "port_changed"
            fi
            read -rp "$(get_str 'press_enter')"
            ;;
        3)
            if [ "$LANG_CHOICE" = "ru" ]; then
                read -rp $'\n'"Введите новый секрет (32 hex символа или с ee): " new_secret
            else
                read -rp $'\n'"Enter new secret (32 hex chars or with ee prefix): " new_secret
            fi
            if [ -n "$new_secret" ]; then
                SECRET=$new_secret
                save_config
                get_str "secret_changed"
            fi
            read -rp "$(get_str 'press_enter')"
            ;;
        4)
            SECRET=$(generate_secret)
            save_config
            get_str "new_secret_gen"
            read -rp "$(get_str 'press_enter')"
            ;;
        5)
            get_str "restarting"
            save_config
            setup_systemd
            systemctl restart tg-proxy.service
            get_str "restarted"
            read -rp "$(get_str 'press_enter')"
            ;;
        6)
            get_str "stopping"
            systemctl stop tg-proxy.service
            get_str "stopped"
            read -rp "$(get_str 'press_enter')"
            ;;
        7)
            test_telegram
            read -rp "$(get_str 'press_enter')"
            ;;
        8)
            if [ "$LANG_CHOICE" = "ru" ]; then
                read -rp "Вы уверены, что хотите УДАЛИТЬ всё? (y/n): " confirm
            else
                read -rp "Are you sure you want to UNINSTALL? (y/n): " confirm
            fi
            if [[ "$confirm" =~ ^[YyДд]$ || "$confirm" == "yes" || "$confirm" == "да" ]]; then
                full_uninstall
            fi
            ;;
        0)
            break
            ;;
    esac
done
